<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Themes for the Flutter Android shell.

      These must NOT reference `Theme.SplashScreen` or `Theme.AppCompat` — those
      live in libraries this app does not depend on, and AAPT fails the release
      build with "resource style/Theme.SplashScreen not found". Plain platform
      themes keep the app free of an AppCompat dependency it does not need.
    -->

    <!-- Shown while the process starts, before the Flutter engine draws its
         first frame. The dark canvas means no white flash on launch. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Applied once the process has started: the colour behind the Flutter UI
         while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Referenced by AndroidManifest.xml. -->
    <style name="AppTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:background">@drawable/launch_background</item>
    </style>
</resources>